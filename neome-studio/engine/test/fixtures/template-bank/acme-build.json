   "deeplinkMap": {
    "keys": [],
    "map": {}
   },
   "autoDiaMap": {
    "keys": [
     "mad-approve",
     "mad-nightly"
    ],
    "map": {
     "mad-approve": {
      "metaId": "mad-approve",
      "name": "wf1",
      "label": "Order approval",
      "nodeMap": {
       "van-ev": {
        "metaId": "van-ev",
        "kind": "eventSsUpdateAfter",
        "name": "NeoEvent",
        "spreadsheetId": "mss-order"
       },
       "van-if": {
        "metaId": "van-if",
        "kind": "branchIfElse",
        "name": "Approved?",
        "condition": {
         "statement": {
          "lhs": {
           "argName": "a",
           "kind": "parameter",
           "value": {
            "paramId": "$Curr",
            "compositeId": "msc-order",
            "fieldId": "mfd-ostatus"
           }
          },
          "operator": "equalTo",
          "rhs": {
           "kind": "derived",
           "value": {
            "derivedFieldId": "mfd-ostatus",
            "valueOptionId": "optApproved"
           }
          }
         }
        }
       },
       "van-msg": {
        "metaId": "van-msg",
        "kind": "sendMessageToUsers",
        "name": "Tell rep",
        "message": {
         "value": "Hi \"Acme\" team, order for Zorbia approved"
        },
        "toUsers": {
         "users": {
          "argName": "a",
          "kind": "parameter",
          "value": {
           "paramId": "$Curr",
           "compositeId": "msc-order",
           "fieldId": "mfd-oappr"
          }
         }
        }
       },
       "van-loop": {
        "metaId": "van-loop",
        "kind": "branchIterateGrid",
        "name": "NeoIterate"
       },
       "van-line": {
        "metaId": "van-line",
        "kind": "rowInsert",
        "name": "rowInsert",
        "spreadsheetId": "mss-line"
       },
       "van-rej": {
        "metaId": "van-rej",
        "kind": "rowUpdate",
        "name": "Mark rejected",
        "spreadsheetId": "mss-order"
       }
      },
      "edgeMap": {
       "e1": {
        "fromNodeId": "van-ev",
        "toNodeId": "van-if",
        "kind": "NEXT"
       },
       "e2": {
        "fromNodeId": "van-if",
        "toNodeId": "van-msg",
        "kind": "TRUE"
       },
       "e3": {
        "fromNodeId": "van-if",
        "toNodeId": "van-rej",
        "kind": "FALSE"
       },
       "e4": {
        "fromNodeId": "van-msg",
        "toNodeId": "van-loop",
        "kind": "NEXT"
       },
       "e5": {
        "fromNodeId": "van-loop",
        "toNodeId": "van-line",
        "kind": "ITERATE"
       },
       "e6": {
        "fromNodeId": "van-line",
        "toNodeId": "van-loop",
        "kind": "NEXT"
       }
      }
     },
     "mad-nightly": {
      "metaId": "mad-nightly",
      "name": "wf2",
      "label": "Nightly cleanup",
      "nodeMap": {
       "van-s": {
        "metaId": "van-s",
        "kind": "eventSchedule",
        "name": "NeoSchedule",
        "scheduler": {
         "repeatSetting": {
          "frequency": 1,
          "repeatFrequencyKind": "day",
          "setOfTime": [
           "02:00"
          ]
         }
        }
       },
       "van-x": {
        "metaId": "van-x",
        "kind": "ssRemoveRows",
        "name": "Purge",
        "spreadsheetId": "mss-old"
       }
      },
      "edgeMap": {
       "e1": {
        "fromNodeId": "van-s",
        "toNodeId": "van-x",
        "kind": "NEXT"
       }
      }
     }
    }
   }
